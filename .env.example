# Copy to .env and fill in. All variables are read by config/settings.py.

# Toggle debug mode. Leave off (unset or "false") in production.
DEBUG=true

# Falls back to an insecure dev key if unset; set a real one outside development.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Comma-separated hostnames, e.g. "feedback.example.com,localhost".
ALLOWED_HOSTS=localhost,127.0.0.1

# Database connection URL. If unset, a local SQLite file is used.
# DATABASE_URL=postgres://user:password@localhost:5432/feedback
